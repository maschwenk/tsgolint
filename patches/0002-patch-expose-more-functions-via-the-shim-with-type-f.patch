From b07e1ec1864273a7381486608bdb0327f6b7a09c Mon Sep 17 00:00:00 2001
From: Max schwenk <maschwenk@gmail.com>
Date: Fri, 2 Oct 2026 12:57:26 -0400
Subject: [PATCH 2/6] patch: expose more functions via the shim with type fixes

Export the config registry builder, snapshot FS builder, and project load kind types through aliases and forwarding wrappers so upstream call sites remain unchanged.
---
 .../project/configfileregistrybuilder.go      |  6 +-
 .../project/projectcollectionbuilder.go       |  6 +-
 tsc/internal/project/snapshotfs.go            |  6 +-
 tsc/internal/project/tsgolint_exports.go      | 58 +++++++++++++++++++
 4 files changed, 73 insertions(+), 3 deletions(-)
 create mode 100644 tsc/internal/project/tsgolint_exports.go

diff --git a/tsc/internal/project/configfileregistrybuilder.go b/tsc/internal/project/configfileregistrybuilder.go
index 2493d3f19f5..122195d506b 100644
--- a/tsc/internal/project/configfileregistrybuilder.go
+++ b/tsc/internal/project/configfileregistrybuilder.go
@@ -24,7 +24,11 @@ var (
 // configFileRegistryBuilder tracks changes made on top of a previous
 // configFileRegistry, producing a new clone with `finalize()` after
 // all changes have been made.
-type configFileRegistryBuilder struct {
+// configFileRegistryBuilder is kept as an alias so upstream call sites are unchanged
+// while TSGolint can link against the exported type name.
+type configFileRegistryBuilder = ConfigFileRegistryBuilder
+
+type ConfigFileRegistryBuilder struct {
 	hasRelativePatternCapability bool
 	fs                           *sourceFS
 	isOpenFile                   func(tspath.Path) bool
diff --git a/tsc/internal/project/projectcollectionbuilder.go b/tsc/internal/project/projectcollectionbuilder.go
index 12443f76258..bd1ac21e8f9 100644
--- a/tsc/internal/project/projectcollectionbuilder.go
+++ b/tsc/internal/project/projectcollectionbuilder.go
@@ -23,7 +23,11 @@ import (
 	"github.com/microsoft/TypeScript/tsc/internal/tspath"
 )
 
-type projectLoadKind int
+// projectLoadKind is kept as an alias so upstream call sites are unchanged
+// while TSGolint can link against the exported type name.
+type projectLoadKind = ProjectLoadKind
+
+type ProjectLoadKind int
 
 const (
 	// Project is not created or updated, only looked up in cache
diff --git a/tsc/internal/project/snapshotfs.go b/tsc/internal/project/snapshotfs.go
index 6dc3bf7c01c..662e797b653 100644
--- a/tsc/internal/project/snapshotfs.go
+++ b/tsc/internal/project/snapshotfs.go
@@ -174,7 +174,11 @@ func mergeCachedDirectoryEntries(directoryEntries vfs.Entries, cachedEntries dir
 	return entries
 }
 
-type snapshotFSBuilder struct {
+// snapshotFSBuilder is kept as an alias so upstream call sites are unchanged
+// while TSGolint can link against the exported type name.
+type snapshotFSBuilder = SnapshotFSBuilder
+
+type SnapshotFSBuilder struct {
 	fs                         LayeredFileSystem
 	cacheFiles                 *dirty.SyncMap[tspath.Path, *cachedFile]
 	cacheDirectories           *dirty.Map[tspath.Path, dirty.CloneableMap[tspath.Path, string]]
diff --git a/tsc/internal/project/tsgolint_exports.go b/tsc/internal/project/tsgolint_exports.go
new file mode 100644
index 00000000000..b436c813751
--- /dev/null
+++ b/tsc/internal/project/tsgolint_exports.go
@@ -0,0 +1,58 @@
+package project
+
+import (
+	"github.com/microsoft/TypeScript/tsc/internal/lsp/lsproto"
+	"github.com/microsoft/TypeScript/tsc/internal/project/logging"
+	"github.com/microsoft/TypeScript/tsc/internal/tsoptions"
+	"github.com/microsoft/TypeScript/tsc/internal/tspath"
+	"github.com/microsoft/TypeScript/tsc/internal/vfs"
+)
+
+// Exported entry points used by TSGolint through generated shims.
+// They forward to upstream's package-internal implementations.
+
+const (
+	ProjectLoadKindFind   = projectLoadKindFind
+	ProjectLoadKindCreate = projectLoadKindCreate
+)
+
+func NewConfigFileRegistryBuilder(
+	hasRelativePatternCapability bool,
+	fs *SnapshotFSBuilder,
+	isOpenFile func(tspath.Path) bool,
+	oldConfigFileRegistry *ConfigFileRegistry,
+	extendedConfigCache *ExtendedConfigCache,
+	snapshotID uint64,
+	sessionOptions *SessionOptions,
+	customConfigFileName string,
+	logger *logging.LogTree,
+) *ConfigFileRegistryBuilder {
+	return newConfigFileRegistryBuilder(hasRelativePatternCapability, fs, isOpenFile, oldConfigFileRegistry, extendedConfigCache, snapshotID, sessionOptions, customConfigFileName, logger)
+}
+
+func (c *ConfigFileRegistryBuilder) FindOrAcquireConfigForFile(
+	configFileName string,
+	configFilePath tspath.Path,
+	filePath tspath.Path,
+	loadKind ProjectLoadKind,
+	logger *logging.LogTree,
+) *tsoptions.ParsedCommandLine {
+	return c.findOrAcquireConfigForFile(configFileName, configFilePath, filePath, loadKind, logger)
+}
+
+func (c *ConfigFileRegistryBuilder) ComputeConfigFileName(fileName string, skipSearchInDirectoryOfFile bool, logger *logging.LogTree) string {
+	return c.computeConfigFileName(fileName, skipSearchInDirectoryOfFile, logger)
+}
+
+func (c *ConfigFileRegistryBuilder) GetAncestorConfigFileName(fileName string, path tspath.Path, configFileName string, logger *logging.LogTree) string {
+	return c.getAncestorConfigFileName(fileName, path, configFileName, logger)
+}
+
+// TsGoLintNewSnapshotFSBuilder creates a SnapshotFSBuilder without overlays for TSGolint use.
+func TsGoLintNewSnapshotFSBuilder(fs vfs.FS, currentDirectory string) *SnapshotFSBuilder {
+	toPath := func(fileName string) tspath.Path {
+		return tspath.ToPath(fileName, currentDirectory, fs.UseCaseSensitiveFileNames())
+	}
+	layered := layerOverlayFileSystem(fs, nil, lsproto.PositionEncodingKindUTF16, toPath)
+	return newSnapshotFSBuilderFromSource(layered, nil, nil, nil, toPath)
+}
